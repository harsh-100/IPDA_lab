# Copy this file to .env and replace the placeholder with your private key.
# .env is excluded by .gitignore and must never be committed or shared.
TANKERKOENIG_API_KEY=replace-with-your-private-key

# Separate login for https://data.tankerkoenig.de historical CSV files.
TANKERKOENIG_DATA_USERNAME=replace-with-your-data-username
TANKERKOENIG_DATA_PASSWORD=replace-with-your-private-key
